{
  "description": "Refuse inline interpreter bodies in Bash and PowerShell tool calls, refuse a leading directory change chained into further commands, and warn as session context usage crosses 50% and each 10% band above.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/no-inline-scripts.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/no-cd-chains.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/context-warn.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking context usage"
          }
        ]
      }
    ]
  }
}
